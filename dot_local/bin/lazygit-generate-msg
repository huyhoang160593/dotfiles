#!/bin/bash
set -euo pipefail

# --- Colors & helpers ---
RED='\033[0;31m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

error()   { echo -e "${RED}${BOLD}Error:${RESET} ${RED}$*${RESET}"; }
warn()    { echo -e "${YELLOW}${BOLD}Warning:${RESET} ${YELLOW}$*${RESET}"; }
success() { echo -e "${GREEN}${BOLD}$*${RESET}"; }
info()    { echo -e "${CYAN}$*${RESET}"; }
# --- End helpers ---

# --- Configurable AI agent settings ---
# Override via environment variables or edit these defaults.
AI_CMD="${AI_CMD:-ante}"
AI_FLAGS="${AI_FLAGS:---no-skills --no-session-save}"
AI_PROMPT_FLAG="${AI_PROMPT_FLAG:--p}"

PROMPT="Write a conventional commit message for the following git diff.

Format rules:
- Type: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
- Scope: optional, in parentheses after type
- Subject: imperative mood, lowercase, no period, max 72 chars
- Body: optional, wrapped at 72 chars
- Footer: optional, for BREAKING CHANGE or issue references

Output ONLY the commit message, nothing else. No explanation, no markdown."
# --- End config ---

# --- Mode ---
MODE="${1:-edit}"
# --- End mode ---

# Check AI agent availability
if ! command -v "$AI_CMD" &>/dev/null; then
  error "'$AI_CMD' not found in PATH."
  info "Install it or set AI_CMD to your AI agent command."
  exit 1
fi

DIFF=$(git diff --cached)
if [ -z "$DIFF" ]; then
  warn "No staged changes to commit."
  exit 1
fi

# shellcheck disable=SC2086
MSG=$(echo "$DIFF" | $AI_CMD $AI_FLAGS $AI_PROMPT_FLAG "$PROMPT" 2>/dev/null | tail -1)

if [ -z "$MSG" ]; then
  error "Failed to generate commit message."
  exit 1
fi

case "$MODE" in
  direct)
    success "Committing: $MSG"
    git commit -m "$MSG"
    ;;
  clipboard)
    if command -v wl-copy &>/dev/null; then
      echo -n "$MSG" | wl-copy
      success "Copied to clipboard: $MSG"
    elif command -v xclip &>/dev/null; then
      echo -n "$MSG" | xclip -selection clipboard
      success "Copied to clipboard: $MSG"
    elif command -v pbcopy &>/dev/null; then
      echo -n "$MSG" | pbcopy
      success "Copied to clipboard: $MSG"
    else
      error "No clipboard tool found (wl-copy, xclip, pbcopy)."
      info "Message: $MSG"
      exit 1
    fi
    ;;
  edit|"")
    success "Commit message: $MSG"
    git commit -m "$MSG"
    ;;
  *)
    error "Unknown mode: $MODE"
    info "Usage: lazygit-generate-msg [edit|direct|clipboard]"
    exit 1
    ;;
esac
