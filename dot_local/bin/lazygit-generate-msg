#!/bin/bash
set -euo pipefail

# --- Colors & helpers ---
RED='\033[0;31m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

error()   { echo -e "${RED}${BOLD}✗ $*${RESET}"; }
warn()    { echo -e "${YELLOW}${BOLD}⚠ $*${RESET}"; }
success() { echo -e "${GREEN}${BOLD}✓ $*${RESET}"; }
info()    { echo -e "${CYAN}ℹ $*${RESET}"; }
# --- End helpers ---

# --- Configurable AI agent settings ---
# Override via environment variables or edit these defaults.
AI_CMD="${AI_CMD:-ante}"
AI_FLAGS="${AI_FLAGS:---no-skills --no-session-save --output-format json --tools ''}"
AI_PROMPT_FLAG="${AI_PROMPT_FLAG:--p}"

PROMPT="Write a conventional commit message for the following git diff.

Format rules:
- Type: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
- Scope: optional, in parentheses after type
- Subject: imperative mood, lowercase, no period, max 72 chars
- Body: optional, wrapped at 72 chars
- Footer: optional, for BREAKING CHANGE or issue references

Output ONLY the commit message, nothing else. No explanation, no markdown."
# --- End config ---

# --- Mode ---
MODE="${1:-direct}"
# --- End mode ---

# Check dependencies
if ! command -v "$AI_CMD" &>/dev/null; then
  error "'$AI_CMD' not found in PATH."
  info "Install it or set AI_CMD to your AI agent command."
  exit 1
fi

if ! command -v jq &>/dev/null; then
  error "'jq' not found in PATH."
  info "Install jq for JSON output parsing."
  exit 1
fi

# Handle undo separately (no diff needed)
if [ "$MODE" = "undo" ]; then
  info "Undoing last commit..."
  LAST_HASH=$(git log -1 --pretty=%h)
  LAST_MSG=$(git log -1 --pretty=%s)
  git reset --soft HEAD~1
  success "Undid [$LAST_HASH] $LAST_MSG (changes staged)"
  exit 0
fi

DIFF=$(git diff --cached)
if [ -z "$DIFF" ]; then
  warn "No staged changes to commit."
  exit 1
fi

# shellcheck disable=SC2086
MSG=$(echo "$DIFF" | $AI_CMD $AI_FLAGS $AI_PROMPT_FLAG "$PROMPT" 2>/dev/null \
  | jq -r 'select(.event.AgentMessage) | .event.AgentMessage' \
  | sed '/^```/d' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^$')

if [ -z "$MSG" ]; then
  error "Failed to generate commit message."
  exit 1
fi

case "$MODE" in
  direct)
    info "Committing..."
    echo
    GIT_OUT=$(git commit -m "$MSG" 2>&1)
    if [ $? -eq 0 ]; then
      success "$GIT_OUT"
    else
      error "Commit failed."
      info "$GIT_OUT"
      exit 1
    fi
    ;;
  push)
    info "Committing..."
    echo
    GIT_OUT=$(git commit -m "$MSG" 2>&1)
    if [ $? -eq 0 ]; then
      success "$GIT_OUT"
      echo
      BRANCH=$(git branch --show-current)
      REMOTE=$(git remote | head -1)
      info "Pushing to $REMOTE/$BRANCH..."
      echo
      PUSH_OUT=$(git push 2>&1)
      if [ $? -eq 0 ]; then
        if [ -n "$PUSH_OUT" ]; then
          info "$PUSH_OUT"
        fi
        success "Pushed to $REMOTE/$BRANCH."
      else
        warn "Push failed. Commit was created locally."
        info "$PUSH_OUT"
      fi
    else
      error "Commit failed."
      info "$GIT_OUT"
      exit 1
    fi
    ;;
  clipboard)
    CLIP_CMD=""
    if command -v wl-copy &>/dev/null; then
      CLIP_CMD="wl-copy"
    elif command -v xclip &>/dev/null; then
      CLIP_CMD="xclip -selection clipboard"
    elif command -v pbcopy &>/dev/null; then
      CLIP_CMD="pbcopy"
    else
      error "No clipboard tool found (wl-copy, xclip, pbcopy)."
      exit 1
    fi

    PREVIEW="$MSG"
    if [ ${#PREVIEW} -gt 60 ]; then
      PREVIEW="${PREVIEW:0:57}..."
    fi

    if echo -n "$MSG" | eval "$CLIP_CMD"; then
      success "Copied: $PREVIEW"
    else
      error "Failed to copy to clipboard."
      exit 1
    fi
    ;;
  *)
    error "Unknown mode: $MODE"
    info "Usage: lazygit-generate-msg [direct|push|clipboard|undo]"
    exit 1
    ;;
esac
