#!/usr/bin/env python3
"""Chezmoi modify script: syncs shared fields, preserves per-machine fields.

Settings reference: https://docs.antigma.ai/configuration/preference
Catalog reference:   https://docs.antigma.ai/reference/catalog-reference
"""

import copy
import json
import sys

# Fields synced from chezmoi on every apply — overwrite existing
SYNCED = {
    "system_prompt": None,
    "append_system_prompt": None,
    "tools": None,
    "auto_memory": None,
    "skills": None,
    "include_skills": None,
    "exclude_skills": None,
    "session_save": None,
    "short_prompt": None,
    "max_concurrent_subagents": None,
    "theme": "Dark mode",
    "has_completed_onboarding": True,
    "ambient_thinking_phrase": None,
    "ambient_prompt_suggestion": None,
    "tips": None,
    "group_tool_activity": None,
    "auto_compact": None,
    "channel": None,
    "render_mode": "fullscreen",
    "status_line": None,
    "status_line_command": {"command": "~/.ante/statusline.sh", "padding": 1},
    "mcp_servers": {"bladebro": {"command": "bladebro", "args": ["mcp"], "env": {}, "enabled_tools": []}},
}

# Per-machine fields — preserved if present, default if missing
LOCAL = {
    "model": "beam-free",
    "provider": "opencode-go",
    "permission_mode": "auto",
    "model_effort": {"mimo-v2.6-flash": "medium", "beam-free": "medium"},
    "provider_model": {"opencode-go": "beam-free", "opencode": "inkling-2-small-free"},
}

# Emission order matching ante's own serialization of settings.json,
# so `chezmoi diff` is clean when live and source agree
ORDER = [
    "model",
    "provider",
    "system_prompt",
    "append_system_prompt",
    "tools",
    "auto_memory",
    "skills",
    "include_skills",
    "exclude_skills",
    "session_save",
    "permission_mode",
    "short_prompt",
    "max_concurrent_subagents",
    "model_effort",
    "mcp_servers",
    "theme",
    "has_completed_onboarding",
    "ambient_thinking_phrase",
    "ambient_prompt_suggestion",
    "tips",
    "group_tool_activity",
    "auto_compact",
    "channel",
    "render_mode",
    "status_line",
    "status_line_command",
    "provider_model",
]

try:
    data = json.load(sys.stdin)
except json.JSONDecodeError:
    data = {}

result = copy.deepcopy(SYNCED)

for key, default in LOCAL.items():
    if key in data:
        result[key] = data[key]
    else:
        result[key] = default

# openrouter is unused — never keep its last-model entry
result["provider_model"].pop("openrouter", None)
# xiaomi-mimo dropped from the catalog (2026-11-01) — same treatment
result["provider_model"].pop("xiaomi-mimo", None)

result = {key: result[key] for key in ORDER if key in result}

json.dump(result, sys.stdout, indent=2, ensure_ascii=False)
sys.stdout.write("\n")
