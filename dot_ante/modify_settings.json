#!/usr/bin/env python3
"""Chezmoi modify script: syncs shared fields, preserves per-machine fields.

Settings reference: https://docs.antigma.ai/configuration/preference
Catalog reference:   https://docs.antigma.ai/reference/catalog-reference
"""

import copy
import json
import sys

# Fields synced from chezmoi on every apply — overwrite existing
SYNCED = {
    "system_prompt": None,
    "append_system_prompt": None,
    "tools": None,
    "auto_memory": None,
    "skills": None,
    "include_skills": None,
    "exclude_skills": None,
    "session_save": None,
    "short_prompt": None,
    "max_concurrent_subagents": None,
    "theme": "Dark mode",
    "has_completed_onboarding": True,
    "ambient_thinking_phrase": None,
    "ambient_prompt_suggestion": None,
    "tips": None,
    "group_tool_activity": None,
    "auto_compact": None,
    "channel": None,
    "render_mode": "inline",
    "status_line": None,
    "status_line_command": {"command": "~/.ante/statusline.sh", "padding": 1},
    "mcp_servers": {"bladebro": {"command": "bladebro", "args": ["mcp"]}},
}

# Per-machine fields — preserved if present, default if missing
LOCAL = {
    "model": "mimo-v2.6-flash",
    "provider": "opencode-go",
    "permission_mode": "auto",
    "model_effort": {"mimo-v2.6-flash": "medium"},
    "provider_model": {"opencode-go": "mimo-v2.6-flash"},
}

try:
    data = json.load(sys.stdin)
except json.JSONDecodeError:
    data = {}

result = copy.deepcopy(SYNCED)

for key, default in LOCAL.items():
    if key in data:
        result[key] = data[key]
    else:
        result[key] = default

# openrouter is unused — never keep its last-model entry
result["provider_model"].pop("openrouter", None)
# xiaomi-mimo dropped from the catalog (2026-11-01) — same treatment
result["provider_model"].pop("xiaomi-mimo", None)

json.dump(result, sys.stdout, indent=2, ensure_ascii=False)
sys.stdout.write("\n")
