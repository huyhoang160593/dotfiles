# ─── Ghostty Config ───────────────────────────────────────────────
# Reference: https://ghostty.org/docs/config/reference
# Managed by chezmoi: dot_config/ghostty/empty_config.ghostty
# ──────────────────────────────────────────────────────────────────

# ─── Font ─────────────────────────────────────────────────────────
font-family = "Maple Mono NF"
font-size = 12
# font-feature = "-calt"                # tắt programming ligatures
# font-feature = "-calt,-liga,-dlig"    # tắt tất cả ligatures

# ─── Theme & Colors ──────────────────────────────────────────────
theme = "Rose Pine Moon"

# ─── Cursor ──────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true
cursor-opacity = 1.0

# ─── Shell Integration ───────────────────────────────────────────
# detect = tự nhận diện shell từ filename (mặc định, recommended)
# fish = ép cứng fish integration dù chạy shell khác
shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo,path

# ─── Notifications ───────────────────────────────────────────────
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 5s
bell-features = system,attention,title

# ─── Clipboard ───────────────────────────────────────────────────
copy-on-select = true
clipboard-paste-protection = true
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true

# ─── Mouse ───────────────────────────────────────────────────────
mouse-hide-while-typing = true

# ─── Link & URL ──────────────────────────────────────────────────
link-url = true
link-previews = true

# ─── Window ──────────────────────────────────────────────────────
window-padding-x = 4
window-padding-y = 2
window-padding-balance = true
window-padding-color = extend
quit-after-last-window-closed = true

# ─── Scrollback ──────────────────────────────────────────────────
scrollback-limit = 10000
scrollbar = never

# ─── Resize Overlay ─────────────────────────────────────────────
# after-first = mặc định, hoạt động tốt trên cả Mango WM lẫn KDE
# resize-overlay = after-first

# ─── Confirm Close ──────────────────────────────────────────────
confirm-close-surface = true

# ─── Transparency & Blur (test sau) ─────────────────────────────
# background-opacity = 0.85
# background-blur = true

# ─── Quick Terminal (test sau) ───────────────────────────────────
# quick-terminal-position = top
# quick-terminal-size = 40%
# quick-terminal-keyboard-interactivity = on-demand

# ─── Window Theme (test sau) ─────────────────────────────────────
# window-theme = ghostty
# window-titlebar-background = #1a1b26
# window-titlebar-foreground = #c0caf5
